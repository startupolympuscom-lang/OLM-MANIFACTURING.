# ── Public (exposed to the browser) ─────────────────────────────
# Canonical site URL, used for metadata, sitemap and structured data.
NEXT_PUBLIC_SITE_URL=https://www.example.com
# Public contact email shown on the site and used for the mailto fallback.
# Leave empty until OLM confirms the address.
NEXT_PUBLIC_CONTACT_EMAIL=

# ── Quote form delivery (server-only, never exposed) ────────────
# Configure ONE of the options below. If none is set, the form validates
# input and offers an email draft / text download instead of pretending
# to send.

# Option A — Resend (https://resend.com)
RESEND_API_KEY=
QUOTE_TO_EMAIL=
# Must be a sender on a domain verified in Resend.
QUOTE_FROM_EMAIL=

# Option B — Webhook (Make, Zapier, n8n, Formspree, CRM endpoint…)
QUOTE_WEBHOOK_URL=
# Optional shared secret, sent as the X-Webhook-Secret header.
QUOTE_WEBHOOK_SECRET=
